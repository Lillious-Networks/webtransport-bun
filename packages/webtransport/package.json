{
	"name": "@lillious-networks/webtransport",
	"version": "0.3.0",
	"description": "Production-focused WebTransport for Bun, Node, and Deno with datagrams and streams via a Rust napi-rs addon (Lillious-Networks fork)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lillious-Networks/webtransport-bun.git"
	},
	"homepage": "https://github.com/Lillious-Networks/webtransport-bun#readme",
	"bugs": {
		"url": "https://github.com/Lillious-Networks/webtransport-bun/issues"
	},
	"keywords": [
		"bun",
		"node",
		"deno",
		"webtransport",
		"quic",
		"napi-rs",
		"realtime"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist/**/*",
		"prebuilds/**/*",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3.9",
		"node": ">=18"
	},
	"os": [
		"darwin",
		"linux",
		"win32"
	],
	"cpu": [
		"arm64",
		"x64"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
		"build": "tsc -p tsconfig.build.json",
		"prebuild:native": "cd ../.. && bun scripts/copy-prebuilds.ts",
		"prebuild:build-and-copy": "cd ../.. && bun run build:native && bun scripts/copy-prebuilds.ts",
		"prebuild:checksums": "cd ../.. && bun scripts/write-sha256sums.ts packages/webtransport/prebuilds",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	}
}
